# Email transazionali e notifiche operative tramite Resend.
RESEND_API_KEY=
RESEND_FROM=Scalers <evento@tiranaoffline.com>
# Indirizzo operativo dell’evento per risposte e notifiche interne.
RESEND_REPLY_TO=evento@tiranaoffline.com
REGISTRATION_NOTIFY_TO=matteo@milonematteo.com,evento@tiranaoffline.com

# Notifiche operative Slack. Usa un Bot User OAuth Token xoxb-... e un channel ID C....
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Registro operativo Google Sheets tramite Web App Apps Script.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
GOOGLE_SHEETS_REQUIRED=false

# Segreto di almeno 32 caratteri per cookie di registrazione e token ordine.
TIRANA_FUNNEL_SECRET=

# Stripe Checkout. Tutte le variabili restano server-side su Vercel.
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Tracking revenue. Il token CAPI resta esclusivamente server-side su Vercel.
META_PIXEL_ID=2605330299866744
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
# Solo per verifiche temporanee dentro Test Events di Meta.
META_TEST_EVENT_CODE=

# Snapshot inventario opzionale. Imposta entrambi i valori oppure lasciali entrambi vuoti.
# Sono contatori manuali e non atomici: il checkout non li incrementa automaticamente.
# Per prenotazioni automatiche e protezione dall'overselling serve uno storage transazionale.
AAW26_TOTAL_ASSIGNED=
AAW26_BUILDER_ASSIGNED=

# Call funnel /call. Link dell'evento di calendario (calendly.com, cal.com, app.cal.com o api.leadconnectorhq.com).
CALL_BOOKING_URL=
# Inoltro opzionale di ogni candidatura verso CRM o automazioni. Il segreto (min. 32 caratteri) firma il body.
CALL_FUNNEL_WEBHOOK_URL=
CALL_FUNNEL_WEBHOOK_SECRET=
