# Necessaria solo per discover_reels, import_reel e get_video con fetch_transcript.
# Ogni chiamata costa 1 credito: https://app.scrapecreators.com
SCRAPECREATORS_API_KEY=

# Dove salvare ganci personali e reel importati (default: ~/.hook-vault).
HOOK_VAULT_DATA_DIR=

# Solo in modalità HTTP (--http): porta e token Bearer richiesto ai client.
PORT=3333
HOOK_VAULT_TOKEN=
