# Copia questo file in .env e compila i valori dell'app LinkedIn
# (https://www.linkedin.com/developers/apps → la tua app → Auth).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Deve essere identico a un "Authorized redirect URL" dell'app.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# Opzionali
# LINKEDIN_SCOPES=openid profile w_member_social w_organization_social
# LINKEDIN_AUTHOR_URN=urn:li:organization:123456   # pubblica di default come pagina aziendale
# LINKEDIN_ACCESS_TOKEN=                            # token generato a mano: salta npm run auth
# LINKEDIN_API_VERSION=202609                       # versione API (YYYYMM)
# LINKEDIN_MCP_HOME=~/.linkedin-mcp                 # dove salvare token, bozze e storico
